{
  "name": "api-escuela",
  "version": "1.0.0",
  "description": "API REST de gestión escolar con pipeline CI/CD (GitHub Actions + Docker Hub + AWS EC2)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --coverage",
    "test:ci": "jest --coverage --ci --coverageReporters=text --coverageReporters=text-summary --coverageReporters=lcov"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
